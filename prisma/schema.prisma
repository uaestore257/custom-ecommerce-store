// =====================================================================
// Multi-store ecommerce platform — database schema (Phase 1)
//
// International by design:
//   * Countries   ISO 3166-1 alpha-2   e.g. AE, US, GB, SA
//   * Currencies  ISO 4217 + minor units (JPY 0, USD 2, KWD 3)
//   * Languages   BCP 47               e.g. en, ar
//   * Timezones   IANA                 e.g. Asia/Dubai (validated in code)
//   * Money       BigInt minor units + a currency code next to every amount
//   * Dates       stored in UTC
// Nothing here defaults to a country, currency or language: each store
// chooses its own. See docs/database.md for the full explanation.
//
// Store isolation: every store-owned table has a required storeId, and
// every reference between store-owned tables is a COMPOSITE foreign key
// that includes storeId, so Postgres itself rejects cross-store links.
// Extra rules the Prisma schema cannot express (CHECK constraints, a
// partial unique index and commit-time triggers) are in the migration SQL.
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TextDirection {
  LTR
  RTL
}

enum StoreStatus {
  DRAFT
  ACTIVE
  PAUSED
  SUSPENDED
}

enum StoreDomainStatus {
  PENDING
  VERIFIED
  DISABLED
}

enum StoreRole {
  OWNER
  MANAGER
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMode {
  TEST
  LIVE
}

/// Whether an order has been paid. Cash on delivery and bank transfer
/// orders start UNPAID; nothing in the storefront ever marks one PAID.
enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  PARTIALLY_REFUNDED
  FAILED
  CANCELLED
  REFUNDED
  RECONCILIATION
}

enum InquiryStatus {
  NEW
  READ
  ARCHIVED
}

// ---------------------------------------------------------------------
// Platform-level reference data (shared, read-only for stores)
// ---------------------------------------------------------------------

/// ISO 3166-1 alpha-2 country.
model Country {
  code String @id @db.Char(2)
  name String

  stores              Store[]
  customerAddresses   CustomerAddress[]
  taxRules            TaxRule[]
  shippingZoneEntries ShippingZoneCountry[]
}

/// ISO 4217 currency. minorUnits = digits after the decimal point.
model Currency {
  code       String @id @db.Char(3)
  name       String
  minorUnits Int

  stores              Store[]
  orders              Order[]
  paymentTransactions PaymentTransaction[]
}

/// BCP 47 language tag, with its writing direction (Arabic = RTL).
model Language {
  code       String        @id @db.VarChar(35)
  name       String
  nativeName String
  direction  TextDirection @default(LTR)

  storeLanguages   StoreLanguage[]
  defaultForStores Store[]         @relation("StoreDefaultLanguage")
}

/// Single row with platform settings. No commercial defaults on purpose.
///
/// Also the AGENCY PROFILE: the single source of truth for the public
/// agency website on the platform root (lib/server/agency.ts). Platform
/// data only — never joined to, or derived from, any Store. Every field
/// here is intended to be public once filled in; empty fields are simply
/// not shown. `platformName` is the agency name and the website name.
/// `team` and `socialLinks` are JSON lists validated by lib/agency/profile.ts
/// on every write and normalized on every read.
model PlatformSettings {
  id           Int      @id @default(1)
  platformName String
  /// Business email shown publicly.
  contactEmail String?
  updatedAt    DateTime @updatedAt

  // Identity
  tagline        String? @db.VarChar(120)
  description    String? @db.VarChar(400)
  /// Logo image URL (https:// or a site path such as /brand/logo.svg).
  logoUrl        String? @db.VarChar(2048)
  /// The logo already contains the agency name: don't repeat the name beside it.
  logoIsWordmark Boolean @default(false)
  /// Square brand mark, used as the website icon.
  brandMarkUrl   String? @db.VarChar(2048)

  // About
  aboutTitle String? @db.VarChar(120)
  aboutBody  String? @db.VarChar(4000)
  /// [{ name, title, bio?, imageUrl? }] — founders and team.
  team       Json    @default("[]")

  // Contact
  phone         String? @db.VarChar(40)
  whatsapp      String? @db.VarChar(40)
  addressLine   String? @db.VarChar(200)
  city          String? @db.VarChar(100)
  region        String? @db.VarChar(100)
  country       String? @db.VarChar(100)
  postalCode    String? @db.VarChar(20)
  businessHours String? @db.VarChar(200)
  /// Where project enquiries are addressed (falls back to contactEmail).
  enquiryEmail  String? @db.VarChar(254)

  // Social: [{ platform, url, label? }]
  socialLinks Json @default("[]")

  // Website / SEO (the website name is always platformName)
  seoTitle       String? @db.VarChar(120)
  seoDescription String? @db.VarChar(300)
  ogImageUrl     String? @db.VarChar(2048)
}

// ---------------------------------------------------------------------
// People and access
// ---------------------------------------------------------------------

/// Staff/admin account (not a shopper). Sign-in is handled by Better Auth
/// (lib/server/auth), which uses this table plus Session, Account,
/// Verification and RateLimit below. `isPlatformOwner` is NOT known to
/// Better Auth, so no auth endpoint can read or set it; it is only set by
/// the platform-owner CLI (scripts/platform-owner.ts). A partial unique
/// index in the migration allows at most one platform owner.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  emailVerified   Boolean   @default(false)
  image           String?
  isPlatformOwner Boolean   @default(false)
  /// Set to block sign-in without deleting the user.
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships              StoreMembership[]
  invitations              StoreInvitation[]         @relation("StoreInvitationSender")
  sessions                 Session[]
  accounts                 Account[]
  auditEvents              AuditEvent[]
  paymentRefunds           PaymentRefund[]
  stripeConnectOAuthStates StripeConnectOAuthState[]
}

// Better Auth core tables (better-auth 1.7.6). Field names and types follow
// its core schema; don't rename them without updating lib/server/auth.

/// Sign-in session. The cookie holds a signed copy of `token`.
model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Login method of a user. Password sign-in uses providerId "credential"
/// and stores the scrypt password hash in `password`.
model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One password login per user (for "credential", accountId = userId).
  @@unique([providerId, accountId])
  @@index([userId])
}

/// Short-lived verification values used by Better Auth.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Rate-limit counters (Better Auth `rateLimit.storage: "database"`), so
/// limits survive restarts and are shared between server instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

/// Append-only record of sensitive actions. Never stores passwords, raw
/// session tokens or invitation tokens. Rows stay when the actor or store
/// is deleted (the reference becomes null).
model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  storeId     String?
  /// e.g. "auth.sign_in", "store.suspend", "platform_owner.create"
  action      String   @db.VarChar(64)
  targetType  String?  @db.VarChar(32)
  targetId    String?  @db.VarChar(64)
  /// Small, non-secret details (e.g. changed field names, status values).
  metadata    Json?
  ipAddress   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  actor User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// A user's role in ONE store. A user can belong to several stores.
model StoreMembership {
  id        String    @id @default(cuid())
  userId    String
  storeId   String
  role      StoreRole
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

/// A single-use, store-scoped invitation. Only a hash of the bearer token
/// is persisted; the raw token is delivered once and never returned to UI.
model StoreInvitation {
  id              String    @id @default(cuid())
  storeId         String
  invitedByUserId String
  email           String    @db.VarChar(254)
  role            StoreRole
  tokenHash       String    @unique @db.Char(64)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("StoreInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([storeId, email])
}

// ---------------------------------------------------------------------
// Store (tenant) and its configuration
// ---------------------------------------------------------------------

model Store {
  id           String      @id @default(cuid())
  slug         String      @unique
  name         String
  businessType String?
  status       StoreStatus @default(DRAFT)

  // Localisation — chosen per store, no platform default.
  countryCode     String  @db.Char(2)
  baseCurrency    String  @db.Char(3)
  timezone        String // IANA, validated in lib/standards.ts
  defaultLanguage String  @db.VarChar(35) // must be enabled in StoreLanguage (commit-time trigger)
  formatLocale    String? @db.VarChar(35) // optional override, e.g. "en-AE"

  // Tax setting only; no tax is calculated in Phase 1.
  pricesIncludeTax Boolean @default(false)

  // Storefront presentation. templateKey names a template in the code
  // registry (lib/templates/registry.ts); an unknown key renders the
  // default template. themeConfig holds only that template's enumerated
  // option choices, normalized on every read (lib/templates/theme.ts):
  // never markup, component names or arbitrary CSS.
  templateKey     String  @default("classic") @db.VarChar(40)
  themeConfig     Json    @default("{}")
  /// A demonstration store (template showcase). Real tenant in every other
  /// respect; demo stores are never indexed by search engines.
  isDemo          Boolean @default(false)
  /// Explicit public Work category slug; validated against SERVICE_CATEGORIES in the application.
  workServiceSlug String? @db.VarChar(40)
  /// Optional display order within the assigned public Work category (lower first).
  workOrder       Int?

  // Branding and contact
  logoUrl      String?
  accentColor  String? @db.VarChar(7)
  contactEmail String?
  contactPhone String? // E.164, e.g. +971500000000

  // Business / legal details. Which are required depends on the country
  // and the payment provider; this must be verified per country later.
  legalName          String?
  registrationNumber String?
  taxId              String?
  /// Generic address (see docs/database.md): line1, line2, city, region,
  /// postalCode, countryCode. No country-specific fields.
  businessAddress    Json?

  // Per-store order numbering, e.g. prefix "NO" -> NO-1001, NO-1002 ...
  orderNumberPrefix String? @db.VarChar(10)
  nextOrderNumber   Int     @default(1001)

  /// Soft delete: archived stores are hidden but can be restored.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  country  Country  @relation(fields: [countryCode], references: [code])
  currency Currency @relation(fields: [baseCurrency], references: [code])
  language Language @relation("StoreDefaultLanguage", fields: [defaultLanguage], references: [code])

  memberships              StoreMembership[]
  invitations              StoreInvitation[]
  domains                  StoreDomain[]
  languages                StoreLanguage[]
  categories               Category[]
  products                 Product[]
  variants                 ProductVariant[]
  customers                Customer[]
  orders                   Order[]
  taxRules                 TaxRule[]
  shippingZones            ShippingZone[]
  shippingRates            ShippingRate[]
  paymentAccounts          PaymentProviderAccount[]
  paymentMethods           StorePaymentMethod[]
  paymentTransactions      PaymentTransaction[]
  paymentWebhookEvents     PaymentWebhookEvent[]
  auditEvents              AuditEvent[]
  paymentRefunds           PaymentRefund[]
  stripeConnectOAuthStates StripeConnectOAuthState[]
  inquiries                Inquiry[]

  // Lets prices reference (storeId, currency) so they must be in the
  // store's base currency. Changing baseCurrency is blocked while prices exist.
  @@unique([id, baseCurrency])
}

/// A hostname owned by exactly one store. Verification tokens are public DNS
/// proof identifiers, never credentials. Only VERIFIED domains route traffic.
model StoreDomain {
  id                String            @id @default(cuid())
  storeId           String
  hostname          String            @unique @db.VarChar(253)
  status            StoreDomainStatus @default(PENDING)
  isPrimary         Boolean           @default(false)
  verificationToken String            @db.VarChar(64)
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Database migration also enforces that only VERIFIED domains can be primary,
  // with at most one verified primary hostname per store.

  @@index([storeId, status])
}

/// Languages a store offers. Content can only be written in these.
/// Disable (enabled = false) instead of deleting to keep existing content.
model StoreLanguage {
  storeId      String
  languageCode String   @db.VarChar(35)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageCode], references: [code])

  storeContent        StoreContentTranslation[]
  categoryTranslation CategoryTranslation[]
  productTranslation  ProductTranslation[]

  @@id([storeId, languageCode])
}

/// Homepage / about text per language.
model StoreContentTranslation {
  storeId   String
  locale    String  @db.VarChar(35)
  tagline   String?
  heroTitle String?
  heroText  String?
  aboutText String?

  storeLanguage StoreLanguage @relation(fields: [storeId, locale], references: [storeId, languageCode], onDelete: Cascade, onUpdate: Restrict)

  @@id([storeId, locale])
}

// ---------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  storeId   String
  position  Int      @default(0)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  translations CategoryTranslation[]
  products     Product[]

  @@unique([id, storeId])
  @@index([storeId, position])
}

model CategoryTranslation {
  categoryId String
  storeId    String
  locale     String @db.VarChar(35)
  name       String
  slug       String

  category      Category      @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)
  storeLanguage StoreLanguage @relation(fields: [storeId, locale], references: [storeId, languageCode], onDelete: NoAction, onUpdate: Restrict)

  @@id([categoryId, locale])
  @@unique([storeId, locale, slug])
}

model Product {
  id               String        @id @default(cuid())
  storeId          String
  categoryId       String?
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  deliveryFeeMinor BigInt        @default(0)
  freeDelivery     Boolean       @default(false)
  pickupOnly       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Composite: the category must belong to the SAME store.
  category     Category?            @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: NoAction, onUpdate: Restrict)
  translations ProductTranslation[]
  variants     ProductVariant[]
  images       ProductImage[]

  @@unique([id, storeId])
  @@index([storeId, status])
}

model ProductTranslation {
  productId   String
  storeId     String
  locale      String @db.VarChar(35)
  name        String
  description String @default("")
  slug        String

  product       Product       @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)
  storeLanguage StoreLanguage @relation(fields: [storeId, locale], references: [storeId, languageCode], onDelete: NoAction, onUpdate: Restrict)

  @@id([productId, locale])
  @@unique([storeId, locale, slug])
}

/// Every product has at least one variant (enforced at commit time) and
/// exactly one default variant (partial unique index). Price, SKU and
/// stock live here so size/colour options can be added later without
/// moving data.
model ProductVariant {
  id             String   @id @default(cuid())
  storeId        String
  productId      String
  sku            String
  title          String? // null for the default variant; e.g. "Large / Blue" later
  isDefault      Boolean  @default(false)
  position       Int      @default(0)
  priceMinor     BigInt
  compareAtMinor BigInt?
  currency       String   @db.Char(3)
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product     @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)
  // Composite: currency must equal the store's base currency.
  storeMoney Store       @relation(fields: [storeId, currency], references: [id, baseCurrency], onDelete: Cascade, onUpdate: Restrict)
  orderItems OrderItem[]

  @@unique([id, storeId])
  @@unique([storeId, sku])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  storeId   String
  productId String
  url       String
  altText   String?
  position  Int     @default(0)

  product Product @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)

  @@index([productId, position])
}

// ---------------------------------------------------------------------
// Customers (separate per store) and orders
// ---------------------------------------------------------------------

model Customer {
  id              String   @id @default(cuid())
  storeId         String
  email           String // stored lower-case (CHECK constraint)
  name            String
  phone           String? // E.164
  preferredLocale String?  @db.VarChar(35)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]

  // The same email can be a customer of two stores; they are separate records.
  @@unique([storeId, email])
  @@unique([id, storeId])
}

/// Generic international address. The country decides which fields are
/// required (validated in code later); no country-specific columns.
model CustomerAddress {
  id            String  @id @default(cuid())
  storeId       String
  customerId    String
  recipientName String
  line1         String
  line2         String?
  city          String
  region        String? // state / province / emirate / county
  postalCode    String?
  countryCode   String  @db.Char(2)
  phone         String?

  customer Customer @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)
  country  Country  @relation(fields: [countryCode], references: [code])

  @@index([customerId])
}

model Order {
  id                 String        @id @default(cuid())
  storeId            String
  number             Int // per-store sequence, shown as "<prefix>-<number>"
  customerId         String?
  status             OrderStatus   @default(PENDING)
  // Snapshot at purchase time: later store changes never alter an order.
  currency           String        @db.Char(3)
  locale             String        @db.VarChar(35)
  pricesIncludeTax   Boolean
  subtotalMinor      BigInt
  shippingMinor      BigInt        @default(0)
  taxMinor           BigInt        @default(0)
  discountMinor      BigInt        @default(0)
  totalMinor         BigInt
  customerName       String
  customerEmail      String
  customerPhone      String?
  shippingAddress    Json
  billingAddress     Json?
  paymentMethod      String?
  paymentStatus      PaymentStatus @default(UNPAID)
  /// Random key the checkout sends with every attempt; a repeated
  /// submission with the same key returns the first order instead of
  /// creating another (unique per store, see @@unique below).
  idempotencyKey     String?       @db.VarChar(64)
  /// Hash of what was ordered, so a reused key with a different request is refused.
  requestFingerprint String?       @db.Char(64)
  isDemo             Boolean       @default(false)
  placedAt           DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Orders keep their own currency (not tied to the store's current base
  // currency) and are never deleted with a store by accident.
  currencyRef         Currency             @relation(fields: [currency], references: [code])
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // Composite: the customer must belong to the SAME store.
  customer            Customer?            @relation(fields: [customerId, storeId], references: [id, storeId], onDelete: NoAction, onUpdate: Restrict)
  items               OrderItem[]
  paymentTransactions PaymentTransaction[]
  paymentRefunds      PaymentRefund[]

  @@unique([storeId, number])
  @@unique([id, storeId, currency])
  // Postgres allows many NULL keys, so orders without a key never clash.
  @@unique([storeId, idempotencyKey])
  @@index([storeId, placedAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  storeId        String
  orderId        String
  currency       String  @db.Char(3)
  variantId      String?
  // Snapshot of the product at purchase time (in the order's language).
  productName    String
  variantTitle   String?
  sku            String
  unitPriceMinor BigInt
  quantity       Int
  taxMinor       BigInt  @default(0)
  lineTotalMinor BigInt

  // Composite: same store AND same currency as the order.
  order   Order           @relation(fields: [orderId, storeId, currency], references: [id, storeId, currency], onDelete: Cascade, onUpdate: Restrict)
  // Composite: the variant must belong to the SAME store. Variants with
  // orders cannot be deleted; archive the product instead.
  variant ProductVariant? @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: NoAction, onUpdate: Restrict)

  @@index([orderId])
}

// ---------------------------------------------------------------------
// Contact / inquiries
// ---------------------------------------------------------------------

/// A message submitted through a store's public Contact page. Not an
/// order and not a customer account: no payment, fulfillment or sign-in
/// is implied. Kept only for the platform owner to read and act on.
model Inquiry {
  id        String        @id @default(cuid())
  storeId   String
  name      String
  email     String
  subject   String?
  message   String
  status    InquiryStatus @default(NEW)
  /// Best-effort spam signal only (see lib/server/rate-limit.ts); never
  /// shown to other stores or used to identify the sender.
  ipAddress String?       @db.VarChar(64)
  createdAt DateTime      @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([storeId, status])
}

// ---------------------------------------------------------------------
// Tax, shipping and payments: configuration only. NO calculations and
// NO provider integration in Phase 1.
// ---------------------------------------------------------------------

model TaxRule {
  id              String  @id @default(cuid())
  storeId         String
  name            String
  countryCode     String  @db.Char(2)
  region          String?
  rateBasisPoints Int // 500 = 5.00 %
  priority        Int     @default(0)
  active          Boolean @default(true)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryCode], references: [code])

  @@index([storeId, countryCode])
}

model ShippingZone {
  id      String @id @default(cuid())
  storeId String
  name    String

  store     Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  countries ShippingZoneCountry[]
  rates     ShippingRate[]

  @@unique([id, storeId])
}

model ShippingZoneCountry {
  id          String  @id @default(cuid())
  storeId     String
  zoneId      String
  countryCode String  @db.Char(2)
  region      String?

  zone    ShippingZone @relation(fields: [zoneId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)
  country Country      @relation(fields: [countryCode], references: [code])

  @@unique([zoneId, countryCode, region])
}

model ShippingRate {
  id            String  @id @default(cuid())
  storeId       String
  zoneId        String
  name          String
  priceMinor    BigInt
  freeOverMinor BigInt?
  currency      String  @db.Char(3)
  active        Boolean @default(true)

  zone       ShippingZone @relation(fields: [zoneId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)
  // Composite: currency must equal the store's base currency.
  storeMoney Store        @relation(fields: [storeId, currency], references: [id, baseCurrency], onDelete: Cascade, onUpdate: Restrict)
}

/// A store's account with a payment provider. SECRETS ARE NEVER STORED
/// HERE: secretRef points to a secret manager / environment variable.
model PaymentProviderAccount {
  id              String      @id @default(cuid())
  storeId         String
  provider        String // e.g. "stripe" — chosen later
  stripeAccountId String?     @db.VarChar(255)
  displayName     String
  mode            PaymentMode @default(TEST)
  enabled         Boolean     @default(false)
  publicConfig    Json        @default("{}")
  secretRef       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  methods       StorePaymentMethod[]
  transactions  PaymentTransaction[]
  webhookEvents PaymentWebhookEvent[]
  refunds       PaymentRefund[]

  @@unique([id, storeId])
  @@unique([stripeAccountId, mode])
}

model StorePaymentMethod {
  id                String  @id @default(cuid())
  storeId           String
  method            String // e.g. cash_on_delivery, card_on_delivery, bank_transfer, online_card
  enabled           Boolean @default(false)
  position          Int     @default(0)
  providerAccountId String?

  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Composite: the provider account must belong to the SAME store.
  providerAccount PaymentProviderAccount? @relation(fields: [providerAccountId, storeId], references: [id, storeId], onDelete: NoAction, onUpdate: Restrict)

  @@unique([storeId, method])
}

/// One store-scoped payment attempt. Provider secrets and callback payloads
/// are never persisted here; provider references are non-secret identifiers.
model PaymentTransaction {
  id                       String                   @id @default(cuid())
  storeId                  String
  orderId                  String
  currency                 String                   @db.Char(3)
  providerAccountId        String?
  method                   String
  amountMinor              BigInt
  status                   PaymentTransactionStatus @default(PENDING)
  idempotencyKey           String                   @db.VarChar(64)
  providerReference        String?                  @db.VarChar(255)
  failureCode              String?                  @db.VarChar(80)
  settledAt                DateTime?
  checkoutAttempt          Int                      @default(0)
  checkoutAttemptStartedAt DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order           Order                   @relation(fields: [orderId, storeId, currency], references: [id, storeId, currency], onDelete: Cascade, onUpdate: Restrict)
  currencyRef     Currency                @relation(fields: [currency], references: [code])
  providerAccount PaymentProviderAccount? @relation(fields: [providerAccountId, storeId], references: [id, storeId], onDelete: NoAction, onUpdate: Restrict)
  webhookEvents   PaymentWebhookEvent[]
  refunds         PaymentRefund[]

  @@unique([storeId, idempotencyKey])
  @@unique([id, storeId])
  @@unique([providerAccountId, providerReference])
  @@index([storeId, orderId, createdAt])
}

/// A signed provider event is recorded only after it has been authenticated;
/// the unique provider event ID makes retries idempotent without retaining raw payloads.
model PaymentWebhookEvent {
  id                String    @id @default(cuid())
  storeId           String
  providerAccountId String
  transactionId     String?
  eventId           String    @db.VarChar(255)
  eventType         String    @db.VarChar(120)
  processedAt       DateTime?
  createdAt         DateTime  @default(now())

  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  providerAccount PaymentProviderAccount @relation(fields: [providerAccountId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)
  transaction     PaymentTransaction?    @relation(fields: [transactionId, storeId], references: [id, storeId], onDelete: Cascade, onUpdate: Restrict)

  @@unique([providerAccountId, eventId])
  @@index([storeId, createdAt])
}

/// Short-lived, single-use OAuth state binds a Stripe authorization to the
/// Store Owner and store that initiated it. Only the state hash is retained.
model StripeConnectOAuthState {
  id          String      @id @default(cuid())
  stateHash   String      @unique @db.Char(64)
  storeId     String
  actorUserId String
  mode        PaymentMode
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime    @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// A refund is recorded only after a Stripe Dashboard refund is verified
/// server-to-server against the connected account and original payment.
model PaymentRefund {
  id                String   @id @default(cuid())
  storeId           String
  orderId           String
  transactionId     String
  providerAccountId String
  actorUserId       String
  stripeRefundId    String   @db.VarChar(255)
  amountMinor       BigInt
  currency          String   @db.Char(3)
  reason            String   @db.VarChar(500)
  createdAt         DateTime @default(now())

  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order           Order                  @relation(fields: [orderId, storeId, currency], references: [id, storeId, currency], onDelete: Restrict, onUpdate: Restrict)
  transaction     PaymentTransaction     @relation(fields: [transactionId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  providerAccount PaymentProviderAccount @relation(fields: [providerAccountId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  actor           User                   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([providerAccountId, stripeRefundId])
  @@index([storeId, orderId, createdAt])
  @@index([transactionId, createdAt])
}
