{
  "name": "custom-ecommerce-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-command.mjs migrate",
    "db:deploy": "node scripts/db-command.mjs deploy",
    "db:deploy:production": "node scripts/db-command.mjs deploy-production",
    "db:seed": "node scripts/db-command.mjs seed",
    "db:reference-data": "tsx --conditions=react-server scripts/reference-data.ts",
    "db:provision-demo-owners": "tsx --conditions=react-server scripts/provision-demo-owners.ts",
    "db:provision-template-demos": "tsx --conditions=react-server scripts/provision-template-demos.ts",
    "db:reset": "node scripts/db-command.mjs reset",
    "db:studio": "prisma studio",
    "platform:create-owner": "tsx --conditions=react-server scripts/platform-owner.ts create",
    "platform:reset-password": "tsx --conditions=react-server scripts/platform-owner.ts reset-password",
    "test:unit": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "test:setup": "node --test tests/unit/setup.test.mjs",
    "test:db": "node scripts/db-command.mjs test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vvo/tzdb": "6.198.0",
    "better-auth": "1.7.6",
    "countries-list": "3.4.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
