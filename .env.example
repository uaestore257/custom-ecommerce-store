# Copy to .env and adjust. Never commit .env or real credentials.
# Local development database (see docker-compose.yml):
DATABASE_URL="postgresql://shop:shop@localhost:5433/shop_dev"
# Host port used by local Docker Compose; align DATABASE_URL and TEST_DATABASE_URL.
POSTGRES_PORT="5433"
# Optional direct URL for Prisma CLI commands. If unset locally, Prisma uses
# DATABASE_URL. Production migration commands require DIRECT_URL.
# Never expose DIRECT_URL to browser/client code or commit either URL.
DIRECT_URL=""
# Separate database used by `npm run test:db` — it is RESET on every run.
# Its name must contain "test".
TEST_DATABASE_URL="postgresql://shop:shop@localhost:5433/shop_test"

# --- Admin authentication (Better Auth) --------------------------------
# Secret that signs session cookies: at least 32 random characters. Generate
# your own (never share or commit it), e.g. in PowerShell or any terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Full URL of the admin. Locally the admin runs on admin.localhost (browsers
# resolve *.localhost to your own computer). In production:
#   BETTER_AUTH_URL="https://admin.codexstore.com"
BETTER_AUTH_URL="http://admin.localhost:3000"
# Exact platform-owner admin host (must match BETTER_AUTH_URL). Store admins
# use admin.<store-slug>.<PLATFORM_ROOT_DOMAIN>; public tenant hosts cannot
# sign in to or serve admin routes.
ADMIN_HOST="admin.localhost:3000"
# Platform root domain. The bare host is the public business/portfolio site;
# active store storefronts use <store-slug>.<this> and store admins use
# admin.<store-slug>.<this>, e.g. admin.nest-and-oak.localhost:3000 locally.
# Rules: lib/store-host.ts.
PLATFORM_ROOT_DOMAIN="localhost"
# Optional temporary preview-only fallback when tenant subdomains cannot be
# routed. ADMIN_HOST and PLATFORM_ROOT_DOMAIN must use the preview hostname.
# Do not enable on the production business root when tenant hostnames work.
STOREFRONT_PREVIEW_MODE=""
# Optional: a client's own domains, as comma-separated host=store-slug
# pairs, e.g. "shop.example.com=nest-and-oak,www.shop.example.com=nest-and-oak".
# Each domain must also point at this app (DNS + TLS at your host).
STORE_DOMAINS=""
# The ONE header your hosting proxy sets to the real client IP (e.g.
# "x-real-ip"). On Vercel it is detected automatically (x-real-ip, which
# Vercel overwrites). Required elsewhere in production: without it every
# visitor would share one sign-in rate-limit bucket, so admin sign-in
# refuses to start. Optional in local development. See lib/auth/trusted-ip.ts.
TRUSTED_IP_HEADER=""

# Optional local-only demo Store Owner provisioning credentials.
# Set unique values locally; never commit actual password values.
DEMO_NEST_AND_OAK_OWNER_PASSWORD=""
DEMO_THREADLINE_OWNER_PASSWORD=""
DEMO_VOLTBOX_OWNER_PASSWORD=""

# Order and store-invitation email delivery. Leave EMAIL_PROVIDER empty to
# disable sending. For local development, use a loopback-only SMTP sink such
# as Mailpit (host 127.0.0.1, port 1025, no credentials, not secure). Production
# requires authenticated TLS SMTP; keep credentials in the host secret store.
EMAIL_PROVIDER=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="true"
